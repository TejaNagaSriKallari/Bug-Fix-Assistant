# Copy this file to .env for local development. On Render, set these as
# Environment Variables in the dashboard instead (never commit real values).

# PORT=8787                      # Render sets this itself
# PUBLIC_URL=http://localhost:8787   # deployed: https://<your-app>.onrender.com

# --- Postgres + pgvector ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bugfix

# --- Embeddings ---
# gemini (hosted, free tier) or ollama (local). Default: gemini if GEMINI_API_KEY is set.
# EMBED_PROVIDER=ollama
# GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Chat LLM (Groq via its OpenAI-compatible API) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- GitHub OAuth App ---
# Callback URL in the OAuth App settings must be ${PUBLIC_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPE=repo read:user   # "public_repo read:user" = public repos only

# --- Sessions ---
# Long random string; encrypts stored GitHub tokens and keeps sign-ins across restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Offline demo:<login> logins (alice/bob). Set false when deployed.
ALLOW_DEMO_AUTH=true

# --- Optional limits ---
# CHAT_LIMIT_PER_HOUR=40
# INDEX_LIMIT_PER_HOUR=3
# CI_LIMIT_PER_HOUR=20
# MINE_MAX_REPOS=15
# MINE_MAX_ISSUES=30
# RELEVANCE_THRESHOLD=0.6
