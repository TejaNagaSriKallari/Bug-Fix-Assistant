{
  "manifest_version": 3,
  "name": "GitHub Bug-Fix Assistant",
  "version": "1.0.0",
  "description": "A chat panel on github.com that surfaces similar past bugs and fixes from your repositories.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://bug-fix-assistant.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bug-Fix Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
